local noclipToggle = makeBtn(p2, "Noclip: □", UDim2.new(0.05, 0, 0.70, 0), UDim2.new(0.35, 0, 0, 28))
local noclipOn, noclipConns = false, {}
local function toggleNoclip()
    noclipOn = not noclipOn
    noclipToggle.Text = noclipOn and "Noclip: ■" or "Noclip: □"
    noclipToggle.BackgroundColor3 = noclipOn and Color3.new(0.2,0.6,0.2) or Color3.new(0.3,0.3,0.4)
    for _, c in ipairs(noclipConns) do c:Disconnect() end
    noclipConns = {}
    if not noclipOn then return end
    local function onChar(char)
        local conn = RunService.Stepped:Connect(function()
            for _, p in ipairs(char:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end)
        table.insert(noclipConns, conn)
    end
    if player.Character then onChar(player.Character) end
    table.insert(noclipConns, player.CharacterAdded:Connect(onChar))
end
noclipToggle.MouseButton1Click:Connect(toggleNoclip)

