local function makeDialogModifier(parent, path, name, y)
    makeLabel(parent, name, UDim2.new(0.05, 0, y, 0))
    local box = makeBox(parent, "修改对话内容", UDim2.new(0.05, 0, y + 0.065, 0), 0.5)
    local btn = makeBtn(parent, "□", UDim2.new(0.87, 0, y + 0.06, 0), UDim2.new(0.08, 0, 0, 24))
    local status = makeLabel(parent, "", UDim2.new(0.05, 0, y + 0.14, 0))
    status.TextSize = 11
    status.TextColor3 = Color3.new(0.5,0.5,0.5)
    local running, thread = false, nil
    local function toggle()
        if running then
            running = false
            if thread then task.cancel(thread) end
            btn.Text, btn.BackgroundColor3 = "□", Color3.new(0.3,0.3,0.4)
            status.Text, status.TextColor3 = "已停止", Color3.new(0.5,0.5,0.5)
            return
        end
        if not path then status.Text, status.TextColor3 = "找不到", Color3.new(1,0.3,0.3) return end
        running = true
        btn.Text, btn.BackgroundColor3 = "■", Color3.new(0.2,0.6,0.2)
        status.Text, status.TextColor3 = "运行中", Color3.new(0.3,0.8,0.3)
        thread = task.spawn(function()
            while running do pcall(function() path.Text = box.Text end) task.wait(0.1) end
        end)
    end
    btn.MouseButton1Click:Connect(toggle)
    box.FocusLost:Connect(function()
        if running then
            pcall(function() path.Text = box.Text end)
            status.Text, status.TextColor3 = "已更新", Color3.new(0.3,0.8,0.3)
            task.wait(0.3)
            if running then status.Text = "运行中" end
        end
    end)
end

