local running, interval, thread = false, 0.1, nil
local function togglePrompt()
    if running then
        running = false
        if thread then task.cancel(thread) end
        promptToggle.Text, promptToggle.BackgroundColor3 = "□", Color3.new(0.3, 0.3, 0.4)
        return
    end
    running = true
    promptToggle.Text, promptToggle.BackgroundColor3 = "■", Color3.new(0.2, 0.6, 0.2)
    thread = task.spawn(function()
        while running do fireproximityprompt(hutalk) task.wait(interval) end
    end)
end
promptToggle.MouseButton1Click:Connect(togglePrompt)
intervalBox.FocusLost:Connect(function()
    local n = tonumber(intervalBox.Text)
    if n and n >= 0.1 and n <= 1 then
        interval = n
        intervalBox.Text = tostring(interval)
        if running then togglePrompt() togglePrompt() end
    else intervalBox.Text = tostring(interval) end
end)

